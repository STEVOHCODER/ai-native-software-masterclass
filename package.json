{
  "name": "masterclass-hub",
  "private": true,
  "version": "1.1.0",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node chapter-08-backend-pipelines-concurrency/server.js",
    "lint": "eslint chapter-00-ai-first-hour chapter-04-git-version-control-safety chapter-08-backend-pipelines-concurrency chapter-09-automated-verification-testing scripts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test chapter-00-ai-first-hour/*.test.js chapter-09-automated-verification-testing/*.test.js",
    "build": "tsc --noEmit",
    "validate:environment": "node scripts/validate-environment.js",
    "validate:labs": "node scripts/validate-labs.js",
    "annotate:markdown": "node scripts/annotate-markdown-commands.js",
    "validate:markdown": "node scripts/validate-markdown-command-annotations.js",
    "security:audit": "npm audit --audit-level=high",
    "self-correct": "node chapter-09-automated-verification-testing/self-correct.js",
    "test:concurrency": "node --test chapter-09-automated-verification-testing/concurrency.test.js",
    "agents:audit": "node -e \"console.log(require('./chapter-00-ai-first-hour/agent-clis').auditAgents())\"",
    "ai:ping": "node -e \"const {resolveProvider,requestCompletion}=require('./chapter-00-ai-first-hour/ai-request'); const p=resolveProvider(); if(!p){console.log('No key set - see chapter-00 LAB.md'); process.exit(0);} requestCompletion({provider:p,prompt:'Reply with exactly: AI ONLINE',maxTokens:16}).then(t=>console.log('model:',p.model,'->',t));\"",
    "checkpoint": "node chapter-04-git-version-control-safety/agent-safety-commit.js --once"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "eslint": "^9.24.0",
    "mongoose": "^8.13.2",
    "react": "^19.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
